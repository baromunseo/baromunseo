{
  "name": "baromunseo",
  "productName": "바로문서",
  "version": "0.1.1",
  "description": "HWP/HWPX 문서를 더블클릭하면 바로 열고, 인쇄하고, 간단히 고치는 무료 PC 프로그램 (rhwp 기반)",
  "main": "src/main.js",
  "license": "MIT",
  "author": "baromunseo",
  "repository": "https://github.com/baromunseo/baromunseo",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/lib.test.js tests/equation.test.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "io.github.baromunseo",
    "productName": "바로문서",
    "files": ["src/**", "studio/**", "third_party/**", "package.json", "LICENSE"],
    "win": {
      "target": ["nsis"],
      "artifactName": "baromunseo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "바로문서"
    },
    "fileAssociations": [
      { "ext": "hwp", "name": "HWP 문서", "description": "HWP 문서", "role": "Editor" },
      { "ext": "hwpx", "name": "HWPX 문서", "description": "HWPX 문서", "role": "Editor" }
    ],
    "publish": [{ "provider": "github", "owner": "baromunseo", "repo": "baromunseo", "releaseType": "release" }]
  }
}
