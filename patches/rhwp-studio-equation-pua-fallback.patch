+/**
+ * 한컴 수식 face(HyhwpEQ·HancomEQN)의 사설 영역(PUA) 글리프 코드를 의미 문자로 되돌린다.
+ *
+ * 엔진은 수식의 기울인 변수·숫자·쉼표·괄호 등을 `HyhwpEQ`의 PUA 코드로 그린다
+ * (`src/renderer/equation/hancom_glyphs.rs`의 `glyph()`). 그 face가 PC에 없으면 어떤 대체
+ * 글꼴에도 그 코드가 없어 □(.notdef)로 그려진다. 한컴이 없는 PC를 위해, face가 없을 때만
+ * 코드를 원래 문자로 되돌려 수학 글꼴로 그린다. 표는 `glyph()`/`semantic_fallback_glyph`와
+ * 같은 규칙으로 만든다(HyhwpEQ는 그리스 문자·큰 연산자 PUA를 쓰지 않는다).
+ */
+
+export interface DecodedGlyph {
+  ch: string;
+  /** 소문자 기울인 변수는 PUA 글리프 자체가 기울어 있다. 대체 글꼴은 italic으로 그려야 한다. */
+  italic: boolean;
+}
+
+export const EQUATION_FALLBACK_FAMILIES = "'Latin Modern Math', 'Cambria Math', 'STIX Two Math', 'Times New Roman', serif";
+
+const EQUATION_FACE = /^(hyhwpeq|hancomeqn)$/i;
+
+export function isEquationFace(family: string): boolean {
+  return EQUATION_FACE.test(family.trim().replace(/^["']|["']$/g, ''));
+}
+
+function buildTable(extended: boolean): Map<number, DecodedGlyph> {
+  const map = new Map<number, DecodedGlyph>();
+  const put = (code: number, ch: string, italic = false) => { if (!map.has(code)) map.set(code, { ch, italic }); };
+  for (let i = 0; i < 26; i++) {
+    put(0xe000 + i, String.fromCharCode(65 + i));         // 기울인 대문자(기울기는 엔진이 shear로 준다)
+    put(0xe0e5 + i, String.fromCharCode(97 + i), true);   // 기울인 소문자
+  }
+  put(0xe03d, '0');
+  for (let d = 1; d <= 9; d++) put(0xe033 + d, String(d));
+  const ops: Array<[number, string]> = [
+    [0xe048, '+'], [0xe046, '-'], [0xe047, '='], [0xe04f, ':'], [0xe055, '<'], [0xe056, '>'],
+    [0xe052, ','], [0xe044, '('], [0xe045, ')'], [0xe050, "'"], [0xe042, '%'],
+  ];
+  for (const [code, ch] of ops) put(code, ch);
+  if (extended) {
+    [...'αβγδεζηθικλμνξοπρστυφχψω'].forEach((c, i) => put(0xe09d + i, c));
+    [...'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ'].forEach((c, i) => put(0xe085 + i, c));
+    put(0xe067, '∑');
+  }
+  return map;
+}
+
+const TABLES = { hyhwpeq: buildTable(false), hancomeqn: buildTable(true) };
+
+export function decodeEquationGlyph(family: string, ch: string): DecodedGlyph | null {
+  const code = ch.codePointAt(0) ?? 0;
+  if (code < 0xe000 || code > 0xf8ff) return null;
+  const key = family.trim().replace(/^["']|["']$/g, '').toLowerCase() as keyof typeof TABLES;
+  return TABLES[key]?.get(code) ?? null;
+}
+
+/** 문자열 전체를 되돌린다. 하나라도 기울인 소문자가 있으면 italic. */
+export function decodeEquationText(family: string, text: string): DecodedGlyph | null {
+  let changed = false;
+  let italic = false;
+  let out = '';
+  for (const c of text) {
+    const d = decodeEquationGlyph(family, c);
+    if (d) { changed = true; italic ||= d.italic; out += d.ch; } else out += c;
+  }
+  return changed ? { ch: out, italic } : null;
+}
+
+/**
+ * 이 PC에서 수식 face가 실제로 그려지는지 한 번만 잰다. 없는 글꼴 이름과 PUA 글자 폭이 같으면 없는 것이다.
+ * `setFont`는 제품의 전역 치환을 거치지 않는 원시 setter여야 한다.
+ */
+const availability = new Map<string, boolean>();
+export function equationFaceAvailable(family: string, setFont: (ctx: CanvasRenderingContext2D, v: string) => void): boolean {
+  const key = family.toLowerCase();
+  const known = availability.get(key);
+  if (known !== undefined) return known;
+  let ok = false;
+  try {
+    // 시험용: 한컴 수식 글꼴이 없는 PC(학원 PC)를 흉내 낸다.
+    if (localStorage.getItem('rhwp.debug.noEquationFace') === '1') { availability.set(key, false); return false; }
+    const canvas = document.createElement('canvas');
+    const ctx = canvas.getContext('2d');
+    if (ctx) {
+      const probe = '';
+      setFont(ctx, `100px "${family}", "__rhwp_missing_face__"`);
+      const withFace = ctx.measureText(probe).width;
+      setFont(ctx, '100px "__rhwp_missing_face__"');
+      const without = ctx.measureText(probe).width;
+      ok = Math.abs(withFace - without) > 0.5;
+    }
+  } catch {
+    ok = false;
+  }
+  availability.set(key, ok);
+  return ok;
+}
