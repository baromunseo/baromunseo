+const MISSING_EQUATION_FACE = Symbol('missingEquationFace');
+type EquationAwareContext = CanvasRenderingContext2D & { [MISSING_EQUATION_FACE]?: string | null };
+
+/** 요청 글꼴이 이 PC에 없는 한컴 수식 face면 그 이름을, 아니면 null. */
+function missingEquationFace(cssFont: string): string | null {
+  const pxIdx = cssFont.indexOf('px ');
+  if (pxIdx < 0) return null;
+  const primary = parseCssFontFamilyList(cssFont.substring(pxIdx + 3))[0];
+  if (!primary || !isEquationFace(primary)) return null;
+  return equationFaceAvailable(primary, setRawCanvasFont) ? null : primary;
+}
+
+/** 수식 face가 없을 때 PUA 코드를 의미 문자로 바꿔 그린다. 기울인 소문자는 italic으로 그린다. */
+function installEquationTextFallback(proto: CanvasRenderingContext2D): void {
+  for (const method of ['fillText', 'strokeText', 'measureText'] as const) {
+    const original = proto[method] as (this: CanvasRenderingContext2D, ...args: unknown[]) => unknown;
+    Object.defineProperty(proto, method, {
+      configurable: true,
+      writable: true,
+      value(this: EquationAwareContext, text: unknown, ...rest: unknown[]) {
+        const face = this[MISSING_EQUATION_FACE];
+        const decoded = face ? decodeEquationText(face, String(text)) : null;
+        if (!decoded) return original.call(this, text, ...rest);
+        if (!decoded.italic) return original.call(this, decoded.ch, ...rest);
+        const font = this.font;
+        setRawCanvasFont(this, /italic/.test(font) ? font : `italic ${font}`);
+        try {
+          return original.call(this, decoded.ch, ...rest);
+        } finally {
+          setRawCanvasFont(this, font);
+        }
+      },
+    });
+  }
+}
